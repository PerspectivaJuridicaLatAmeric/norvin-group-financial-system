import React, { useEffect, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { createClient } from '@supabase/supabase-js';
import './style.css';

const url = import.meta.env.VITE_SUPABASE_URL;
const key = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY;
const supabase = url && key ? createClient(url, key) : null;

const modules = [
  {key:'clients', label:'Clientes', table:'clients', cols:['name','email','phone'], fields:[['name','Nombre'],['email','Correo'],['phone','Teléfono']]},
  {key:'projects', label:'Proyectos', table:'projects', cols:['name','status','location','budget'], fields:[['name','Nombre'],['status','Estado'],['location','Ubicación'],['budget','Presupuesto']]},
  {key:'invoices', label:'Facturas', table:'invoices', cols:['invoice_number','issue_date','status','total'], fields:[['invoice_number','Número de factura'],['issue_date','Fecha (AAAA-MM-DD)'],['status','Estado'],['total','Total']]},
  {key:'payments', label:'Pagos', table:'payments', cols:['payment_date','amount','method','reference'], fields:[['payment_date','Fecha (AAAA-MM-DD)'],['amount','Cantidad'],['method','Método'],['reference','Referencia']]},
  {key:'expenses', label:'Gastos', table:'expenses', cols:['expense_date','category','vendor','amount'], fields:[['expense_date','Fecha (AAAA-MM-DD)'],['category','Categoría'],['vendor','Proveedor'],['description','Descripción'],['amount','Cantidad']]},
  {key:'employees', label:'Empleados', table:'employees', cols:['first_name','last_name','email','employment_status'], fields:[['first_name','Nombre'],['last_name','Apellido'],['email','Correo'],['phone','Teléfono'],['employment_status','Estado laboral']]},
  {key:'payroll_entries', label:'Nómina', table:'payroll_entries', cols:['pay_date','gross_pay','net_pay'], fields:[['employee_id','ID del empleado'],['pay_date','Fecha de pago (AAAA-MM-DD)'],['gross_pay','Pago bruto'],['federal_withholding','Retención federal'],['state_withholding','Retención estatal'],['social_security','Seguro Social'],['medicare','Medicare'],['other_deductions','Otras deducciones'],['net_pay','Pago neto']]},
  {key:'contractors', label:'Contratistas', table:'contractors', cols:['name','email','status'], fields:[['name','Nombre'],['email','Correo'],['phone','Teléfono'],['status','Estado']]},
  {key:'contractor_payments', label:'Pagos a contratistas', table:'contractor_payments', cols:['payment_date','amount','description'], fields:[['contractor_id','ID del contratista'],['payment_date','Fecha de pago (AAAA-MM-DD)'],['amount','Cantidad'],['description','Descripción']]}
];

function App(){
  const [session,setSession]=useState(null), [email,setEmail]=useState(''), [password,setPassword]=useState('');
  const [active,setActive]=useState('overview'), [rows,setRows]=useState([]), [loading,setLoading]=useState(false), [error,setError]=useState(''), [message,setMessage]=useState('');
  const [showForm,setShowForm]=useState(false), [values,setValues]=useState({});
  useEffect(()=>{ if(!supabase)return; supabase.auth.getSession().then(({data})=>setSession(data.session)); const {data:{subscription}}=supabase.auth.onAuthStateChange((_e,s)=>setSession(s)); return ()=>subscription.unsubscribe(); },[]);
  const mod=modules.find(m=>m.key===active);
  async function signIn(e){e.preventDefault();setError(''); if(!supabase){setError('Falta configurar el archivo .env con la URL y la clave publicable de Supabase.');return;} const {error}=await supabase.auth.signInWithPassword({email,password});if(error)setError(error.message);}
  async function load(table){if(!supabase||!session)return;setLoading(true);setError('');setMessage('');const {data,error}=await supabase.from(table.table).select('*').order('created_at',{ascending:false}).limit(100);if(error){setError(error.message);setRows([]);}else setRows(data||[]);setLoading(false);}
  useEffect(()=>{if(session&&mod)load(mod);else setRows([]);},[session,active]);
  async function save(e){e.preventDefault();setError('');setMessage('');const payload={};for(const [k,v] of Object.entries(values)){if(v!==''&&v!==undefined)payload[k]=v;}
    for(const k of ['budget','total','amount','gross_pay','federal_withholding','state_withholding','social_security','medicare','other_deductions','net_pay'])if(payload[k]!==undefined)payload[k]=Number(payload[k]);
    const {error}=await supabase.from(mod.table).insert(payload);if(error){setError(error.message);return;}setMessage('Registro guardado.');setShowForm(false);setValues({});load(mod);}
  if(!supabase)return <main className="login"><section className="panel"><div className="brand">NG</div><h1>NORVIN GROUP LLC</h1><p>Sistema financiero de la empresa</p><div className="notice">La interfaz está preparada. Falta añadir la URL y la clave publicable del proyecto en el archivo <code>.env</code> antes de iniciar sesión.</div></section></main>;
  if(!session)return <main className="login"><form className="panel" onSubmit={signIn}><div className="brand">NG</div><h1>NORVIN GROUP LLC</h1><p>Sistema financiero de la empresa</p><label>Correo electrónico<input type="email" value={email} onChange={e=>setEmail(e.target.value)} required placeholder="correo@empresa.com"/></label><label>Contraseña<input type="password" value={password} onChange={e=>setPassword(e.target.value)} required/></label><button className="primary">Iniciar sesión</button>{error&&<p className="error">{error}</p>}<small>El usuario debe existir en Supabase Auth y tener una contraseña configurada.</small></form></main>;
  return <div className="layout"><aside><div className="brand">NG</div><h2>NORVIN<br/>GROUP LLC</h2><p className="muted">FINANZAS</p><button className={active==='overview'?'nav active':'nav'} onClick={()=>setActive('overview')}>Resumen</button>{modules.map(m=><button key={m.key} className={active===m.key?'nav active':'nav'} onClick={()=>{setActive(m.key);setShowForm(false)}}>{m.label}</button>)}<button className="nav logout" onClick={()=>supabase.auth.signOut()}>Cerrar sesión</button></aside><main className="content"><header><div><p className="muted">PANEL DE CONTROL</p><h1>{mod?mod.label:'Resumen financiero'}</h1></div><span className="email">{session.user.email}</span></header>{error&&<div className="alert">{error}</div>}{message&&<div className="success">{message}</div>}{active==='overview'?<><div className="welcome"><h2>Bienvenido</h2><p>Administra los registros financieros de tu empresa desde un solo lugar.</p></div><div className="grid">{modules.map(m=><button className="tile" key={m.key} onClick={()=>setActive(m.key)}><strong>{m.label}</strong><span>Ver registros →</span></button>)}</div><p className="footnote">Los importes y registros solo aparecerán cuando se ingresen datos. Confirma con tu contadora las obligaciones fiscales y de nómina antes de realizar pagos.</p></>:<><div className="toolbar"><span>{rows.length} registro(s) cargados</span><button className="primary" onClick={()=>{setShowForm(!showForm);setValues({})}}>＋ Agregar registro</button></div>{showForm&&<form className="formgrid" onSubmit={save}>{mod.fields.map(([k,label])=><label key={k}>{label}<input value={values[k]||''} type={['amount','total','budget','gross_pay','federal_withholding','state_withholding','social_security','medicare','other_deductions','net_pay'].includes(k)?'number':'text'} step="0.01" onChange={e=>setValues({...values,[k]:e.target.value})} placeholder={label}/></label>)}<div className="formactions"><button className="primary">Guardar</button><button type="button" onClick={()=>setShowForm(false)}>Cancelar</button></div></form>}<div className="tablewrap">{loading?<p>Cargando registros…</p>:rows.length===0?<div className="empty">No hay registros para mostrar todavía.</div>:<table><thead><tr>{mod.cols.map(c=><th key={c}>{c.replaceAll('_',' ')}</th>)}</tr></thead><tbody>{rows.map((r,i)=><tr key={r.id||i}>{mod.cols.map(c=><td key={c}>{r[c]??'—'}</td>)}</tr>)}</tbody></table>}</div></>}</main></div>
}
createRoot(document.getElementById('root')).render(<App/>);
